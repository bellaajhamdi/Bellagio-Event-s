{
  "name": "playtech-manouba",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site web Play Tech Manouba — vente et réparation d'ordinateurs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "db:local": "wrangler d1 migrations apply playtech-db --local",
    "hosting:setup": "node scripts/setup-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
