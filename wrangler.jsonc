{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playtech-manouba",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playtech-db",
      "migrations_dir": "migrations"
    }
  ]
}
